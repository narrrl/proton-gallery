[Desktop Entry]
Type=Application
Name=Proton Gallery
GenericName=Photo Browser
Comment=Browse your Proton Photos library and view still photos
Exec=proton-gallery
Icon=/usr/share/pixmaps/proton-gallery.png
Terminal=false
Categories=Graphics;Photography;Viewer;
Keywords=proton;photos;gallery;pictures;images;
StartupNotify=true
SingleMainWindow=true
StartupWMClass=io.narl.proton-gallery
